# Copy to backend/.env for local development. Never commit the real file.

# ---- OneStepGPS ------------------------------------------------------------
# Leave the key empty to run against the built-in simulator (10 fake vehicles
# driving around San Diego). The key is only ever read server-side.
ONESTEPGPS_API_KEY=
ONESTEPGPS_BASE_URL=https://track.onestepgps.com/v3/api/public/device
ONESTEPGPS_TIMEOUT=12s
ONESTEPGPS_MAX_ATTEMPTS=3
# Force the simulator even when a key is present.
DEMO_MODE=false

# ---- Google Maps -----------------------------------------------------------
# A browser key: it is served to the client at runtime via GET /api/v1/config.
# Restrict it by HTTP referrer in Cloud Console — that, not secrecy, is what
# protects it. Without it the vehicle list still works; only the map is blank.
GOOGLE_MAPS_API_KEY=

# ---- Server ----------------------------------------------------------------
APP_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Serve a built frontend from the same origin (the Docker image sets this).
STATIC_DIR=

# ---- Storage ---------------------------------------------------------------
DB_PATH=data/fleetview.db

# ---- Polling & history -----------------------------------------------------
POLL_INTERVAL=10s
HISTORY_ENABLED=true
HISTORY_RETENTION=24h

# ---- Limits ----------------------------------------------------------------
ICON_MAX_BYTES=262144
RATE_LIMIT_ENABLED=true
