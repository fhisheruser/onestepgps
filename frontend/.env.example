# Frontend build-time configuration.
#
# There is no Google Maps key here on purpose: the browser fetches it at
# runtime from the backend (GET /api/v1/config), so one built image works in
# every environment. Set GOOGLE_MAPS_API_KEY on the *backend* instead.

# Where the API lives. Leave as-is when the frontend is served behind the same
# origin as the backend (docker compose, Cloud Run, or the Vite dev proxy).
VITE_API_BASE_URL=/api/v1

# Only used by `npm run dev`: where the Vite dev server proxies /api to.
VITE_BACKEND_ORIGIN=http://localhost:8080
